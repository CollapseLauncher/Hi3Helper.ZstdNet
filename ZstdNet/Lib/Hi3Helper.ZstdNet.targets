<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemGroup Condition="'$(Platform)' == 'AnyCPU'">
		<!-- win-x86 -->
		<None Include="$(MSBuildThisFileDirectory)Lib\win-x86\*">
			<Link>Lib\win-x86\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>

		<!-- win-x64 -->
		<None Include="$(MSBuildThisFileDirectory)Lib\win-x64\*">
			<Link>Lib\win-x64\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>

		<!-- win-arm -->
		<None Include="$(MSBuildThisFileDirectory)Lib\win-arm\*">
			<Link>Lib\win-arm\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>

		<!-- win-arm64 -->
		<None Include="$(MSBuildThisFileDirectory)Lib\win-arm64\*">
			<Link>Lib\win-arm64\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>

		<!-- linux-x64 -->
		<None Include="$(MSBuildThisFileDirectory)Lib\linux-x64\*">
			<Link>Lib\linux-x64\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<!-- win-x86 -->
		<None Include="$(MSBuildThisFileDirectory)Lib\win-x86\*" Condition="'$(Platform)' == 'x86' and $([MSBuild]::IsOSPlatform('Windows'))">
			<Link>Lib\win-x86\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>

		<!-- win-x64 -->
		<None Include="$(MSBuildThisFileDirectory)Lib\win-x64\*" Condition="'$(Platform)' == 'x64' and $([MSBuild]::IsOSPlatform('Windows'))">
			<Link>Lib\win-x64\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>

		<!-- win-arm -->
		<None Include="$(MSBuildThisFileDirectory)Lib\win-arm\*" Condition="'$(Platform)' == 'arm' and $([MSBuild]::IsOSPlatform('Windows'))">
			<Link>Lib\win-arm\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>

		<!-- win-arm64 -->
		<None Include="$(MSBuildThisFileDirectory)Lib\win-arm64\*" Condition="'$(Platform)' == 'arm64' and $([MSBuild]::IsOSPlatform('Windows'))">
			<Link>Lib\win-arm64\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>

		<!-- linux-x64 -->
		<None Include="$(MSBuildThisFileDirectory)Lib\linux-x64\*" Condition="'$(Platform)' == 'x64' and $([MSBuild]::IsOSPlatform('Linux'))">
			<Link>Lib\linux-x64\%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
